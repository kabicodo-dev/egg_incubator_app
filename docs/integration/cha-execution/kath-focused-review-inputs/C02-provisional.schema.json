{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SmartHatch C-02 0.1.0-provisional — not implemented firmware",
  "description": "PROPOSED — PENDING A-01 VERIFICATION. Shape validation only; not authentication or physical evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "type", "device_id", "chamber", "batch_id", "command_id", "boot_id", "sample_id", "seq", "measured_at", "timestamp_valid", "payload"],
  "properties": {
    "v": {"type": "integer", "const": 1},
    "type": {"enum": ["telemetry", "command", "ack", "status", "error"]},
    "device_id": {"$ref": "#/$defs/id"},
    "chamber": {"const": "incubator"},
    "batch_id": {"$ref": "#/$defs/nullableId"},
    "command_id": {"$ref": "#/$defs/nullableId"},
    "boot_id": {"$ref": "#/$defs/nullableId"},
    "sample_id": {"$ref": "#/$defs/nullableId"},
    "seq": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 9007199254740991}, {"type": "null"}]},
    "measured_at": {"$ref": "#/$defs/nullableUtc"},
    "timestamp_valid": {"type": "boolean"},
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"timestamp_valid": {"const": true}}},
      "then": {"properties": {"measured_at": {"$ref": "#/$defs/utc"}}},
      "else": {"properties": {"measured_at": {"type": "null"}}}
    },
    {
      "if": {"properties": {"type": {"const": "command"}}},
      "then": {
        "properties": {
          "command_id": {"$ref": "#/$defs/id"},
          "boot_id": {"type": "null"}, "sample_id": {"type": "null"}, "seq": {"type": "null"},
          "measured_at": {"type": "null"}, "timestamp_valid": {"const": false},
          "payload": {"$ref": "#/$defs/command"}
        },
        "allOf": [{
          "if": {"properties": {"payload": {"properties": {"action": {"enum": ["START", "STOP"]}}, "required": ["action"]}}},
          "then": {"properties": {"batch_id": {"$ref": "#/$defs/id"}}}
        }]
      },
      "else": {"properties": {"boot_id": {"$ref": "#/$defs/id"}, "seq": {"type": "integer"}}}
    },
    {
      "if": {"properties": {"type": {"const": "telemetry"}}},
      "then": {"properties": {"command_id": {"type": "null"}, "sample_id": {"$ref": "#/$defs/id"}, "payload": {"$ref": "#/$defs/telemetry"}}},
      "else": {"properties": {"sample_id": {"type": "null"}}}
    },
    {
      "if": {"properties": {"type": {"const": "ack"}}},
      "then": {"properties": {"command_id": {"$ref": "#/$defs/id"}, "payload": {"$ref": "#/$defs/ack"}}}
    },
    {
      "if": {"properties": {"type": {"const": "status"}}},
      "then": {
        "properties": {"payload": {"$ref": "#/$defs/status"}},
        "allOf": [{
          "if": {"properties": {"payload": {"properties": {"verification": {"const": "VERIFIED"}}, "required": ["verification"]}}},
          "then": {"properties": {"batch_id": {"$ref": "#/$defs/id"}, "command_id": {"$ref": "#/$defs/id"}}}
        }]
      }
    },
    {
      "if": {"properties": {"type": {"const": "error"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/error"}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "nullableId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "nullableUtc": {"anyOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]},
    "sensor": {
      "type": "object", "additionalProperties": false, "required": ["value", "valid"],
      "properties": {"value": {"type": ["number", "null"]}, "valid": {"type": "boolean"}},
      "allOf": [{"if": {"properties": {"valid": {"const": true}}}, "then": {"properties": {"value": {"type": "number"}}}, "else": {"properties": {"value": {"type": "null"}}}}]
    },
    "telemetry": {
      "type": "object", "additionalProperties": false, "required": ["temperature_c", "humidity_pct"],
      "properties": {
        "temperature_c": {"$ref": "#/$defs/sensor"},
        "humidity_pct": {"allOf": [{"$ref": "#/$defs/sensor"}, {"properties": {"value": {"type": ["number", "null"], "minimum": 0, "maximum": 100}}}]}
      }
    },
    "command": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["action", "profile_id", "profile_version"], "properties": {"action": {"const": "START"}, "profile_id": {"$ref": "#/$defs/id"}, "profile_version": {"$ref": "#/$defs/id"}}},
        {"type": "object", "additionalProperties": false, "required": ["action"], "properties": {"action": {"enum": ["STOP", "STATUS"]}}}
      ]
    },
    "errorCode": {"enum": ["UNSUPPORTED_VERSION", "INVALID_MESSAGE", "WRONG_DEVICE", "BATCH_MISMATCH", "DUPLICATE_CONFLICT", "SENSOR_INVALID", "CLOCK_INVALID", "UNSUPPORTED_COMMAND", "UNSAFE_TO_START", "INTERNAL_ERROR"]},
    "ack": {
      "type": "object", "additionalProperties": false, "required": ["received", "accepted", "code"],
      "properties": {"received": {"const": true}, "accepted": {"type": "boolean"}, "code": {"anyOf": [{"$ref": "#/$defs/errorCode"}, {"type": "null"}]}},
      "allOf": [{"if": {"properties": {"accepted": {"const": true}}}, "then": {"properties": {"code": {"type": "null"}}}, "else": {"properties": {"code": {"$ref": "#/$defs/errorCode"}}}}]
    },
    "status": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "verification", "evidence_id", "original_start_at", "original_start_valid", "inspection_required"],
      "properties": {
        "state": {"enum": ["UNKNOWN", "STOPPED", "RUNNING", "ERROR"]},
        "verification": {"enum": ["UNKNOWN", "CONTROLLER_REPORTED", "VERIFIED"]},
        "evidence_id": {"$ref": "#/$defs/nullableId"},
        "original_start_at": {"$ref": "#/$defs/nullableUtc"},
        "original_start_valid": {"type": "boolean"},
        "inspection_required": {"type": ["boolean", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"original_start_valid": {"const": true}}}, "then": {"properties": {"original_start_at": {"$ref": "#/$defs/utc"}}}, "else": {"properties": {"original_start_at": {"type": "null"}}}},
        {"if": {"properties": {"verification": {"const": "VERIFIED"}}},
          "then": {
            "properties": {"evidence_id": {"$ref": "#/$defs/id"}, "state": {"enum": ["STOPPED", "RUNNING", "ERROR"]}, "inspection_required": {"type": "boolean"}},
            "allOf": [{"if": {"properties": {"state": {"const": "RUNNING"}}}, "then": {"properties": {"original_start_valid": {"const": true}}}}]
          },
          "else": {"properties": {"evidence_id": {"type": "null"}}}
        }
      ]
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code", "detail"],
      "properties": {"code": {"$ref": "#/$defs/errorCode"}, "detail": {"type": "string", "minLength": 1, "maxLength": 160}}
    }
  }
}
