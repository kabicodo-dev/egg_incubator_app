# SmartHatch public client configuration - PLACEHOLDERS ONLY.
# Copy this file to .env (kept out of version control) and replace the
# placeholders with your project's PUBLIC values from the Supabase
# dashboard (Settings -> API).
#
# Both values are public client configuration by design: the anon /
# publishable key ships inside the app bundle and is visible to anyone
# using the app. Database security comes from Supabase row-level security
# (RLS), not from key secrecy. NEVER put privileged keys (such as
# service_role) in .env.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
