# SmartHatch public client configuration (example).
#
# Copy this file to `.env` and replace the placeholders with your project's
# public values. `.env` is ignored by Git; never commit it.
#
# Only these two public client values belong here. Never add a service_role or
# other privileged key to a client build.
#
# Run locally with:
#   flutter run --dart-define-from-file=.env

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
